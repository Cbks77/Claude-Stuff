# Kapso.ai – WhatsApp Agent Pipeline Environment Variables
# Copy this file to .env and fill in your actual keys — never commit .env to git

KAPSO_API_KEY=your_kapso_api_key_here
KAPSO_BASE_URL=https://api.kapso.ai

# Your provisioned WhatsApp digital number:
KAPSO_PHONE_NUMBER=+12028808947

# Phone Number ID from Kapso dashboard:
KAPSO_PHONE_NUMBER_ID=1042608998945774

# OpenRouter LLM (get key from https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_key_here
MODEL=google/gemini-2.0-flash-exp:free

# Meta WhatsApp Cloud API proxy endpoint:
# https://api.kapso.ai/meta/whatsapp/v24.0/1042608998945774/messages
